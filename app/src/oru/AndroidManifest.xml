<?xml version="1.0" encoding="utf-8"?>
<!--
  Oru overlay. The Firebase messaging service is Morphe's push channel. Oru has no Firebase config and no
  push feed, so the service is removed here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <service android:name="app.morphe.manager.service.MorpheFcmService" tools:node="remove" />
    </application>

</manifest>
