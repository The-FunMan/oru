# The patch bundle the patch API guard runs against in CI. Pinned by tag and checksum so a CI run does not change
# when upstream publishes a release. To move it: pick a release, download its bundle, check it with
# tools/parity/patch_api_guard.py, then change the tag, the asset name and the checksum together in one commit.
BUNDLE_REPO=MorpheApp/morphe-patches
BUNDLE_TAG=v1.47.0
BUNDLE_ASSET=patches-1.47.0.mpp
BUNDLE_SHA256=e6c5594b79b0aa0db70096c1195587c9de5af517ea097dff0f1d70ba5726fe44
